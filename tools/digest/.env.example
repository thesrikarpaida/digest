# Copy to ".env" for local runs (this file is safe to commit; .env is git-ignored).
# For GitHub Actions, DO NOT put keys here — add them as repo secrets
# (Settings > Secrets and variables > Actions).

# Which provider to try first; the other is used as an automatic fallback.
#   gemini     -> Google Gemini (free tier, large context) [default]
#   openrouter -> OpenRouter
LLM_PRIMARY=gemini

# --- Google Gemini (primary) ---
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# GitHub Actions secret name: GEMINI_API_KEY
GEMINI_API_KEY=
# gemini-2.5-flash is the default (thinking auto-disabled for speed).
# gemini-2.5-flash-lite is faster/lighter but follows instructions less well
# (more over-production / duplicates); flash is recommended now that thinking
# is off. Both are free-tier eligible.
GEMINI_MODEL=gemini-2.5-flash
# Max length of the model's JSON reply. NOT a billing/quota setting — free
# models stay free; you're only metered on tokens actually generated. Raise it
# only if you ever see "could not parse JSON" (truncated output).
GEMINI_MAX_OUTPUT_TOKENS=16384

# --- OpenRouter (fallback) ---
# Key from https://openrouter.ai/keys ; GitHub Actions secret: OPENROUTER_API_KEY
OPENROUTER_API_KEY=
# Free options: meta-llama/llama-3.3-70b-instruct:free,
#   deepseek/deepseek-chat-v3-0324:free, google/gemini-2.0-flash-exp:free
# Paid: anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# How many hours back to consider feed items as "new".
# Default 180h (~7.5 days) suits the weekly Monday schedule.
DIGEST_LOOKBACK_HOURS=180

# Max candidate items pulled from feeds before the model curates them down.
DIGEST_MAX_CANDIDATES=120

# How many feeds to fetch in parallel. Higher = faster fetch (the slow step
# with a big feed list); lower if your network/CI dislikes the concurrency.
DIGEST_FETCH_WORKERS=24

# Minimum seconds between requests to the SAME host. Prevents rate-limit
# cascades when one host (e.g. medium.com) carries many feeds. Raise if you
# still see 429s from a busy host; lower for a faster run.
DIGEST_HOST_GAP=0.8

# Set "true" to list every unreachable feed; otherwise just a skipped count.
DIGEST_VERBOSE=false

# Max items the model is allowed to publish per run.
DIGEST_MAX_PUBLISH=20

# Max items flagged "Top Pick" (must_know) per run; the rest are demoted so
# Top Picks stays a short, high-impact list.
DIGEST_MAX_MUST_KNOW=5

# OpenRouter fallback only: it curates over the trusted core feeds
# (feeds-core.txt), capped to this many newest candidates — a smaller payload
# for free models with tight context/rate limits. Gemini sees the full list.
OPENROUTER_MAX_CANDIDATES=40

# If every LLM provider fails, publish nothing instead of dumping raw,
# un-curated link posts. Keep "false" for live runs to avoid junk; set "true"
# only if you want raw output while testing locally.
DIGEST_ALLOW_RAW_FALLBACK=false

# Optional metadata sent to OpenRouter for its dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
